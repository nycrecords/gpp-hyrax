<% provide :page_header do %>
  <h1><span class="fa fa-pencil-square-o"></span><%= @agency.name %></h1>
<% end %>

<div class="panel panel-default" data-agency-id="<%= @agency.id %>">
  <div class="panel-heading clearfix">
    <form id="add-item-form" class="pull-right">
      <div class="input-group">
        <select id="new-item-input" class="form-control" required>
          <option value="">Select an agency to alias</option>
          <% @agencies_list.each do |agency| %>
            <option value="<%= agency.id %>"><%= agency.name %></option>
          <% end %>
        </select>
        <div class="input-group-btn">
          <button id="add-item-btn" class="btn btn-primary">Add Alias</button>
        </div>
      </div>
      <div id="item-error-message" class="help-block" style="display: none;"></div>
    </form>
    <button id="delete-item-btn" class="btn btn-danger" style="display: none;">Delete Selected</button>
  </div>

  <div class="panel-body">
    <div class="table-responsive">
      <table class="table table-striped datatable agency-aliases-table">
        <thead>
          <tr>
            <th scope="col" class="check-all no-sort check-all-checkbox-column">
              <%= check_box_tag "check_all", "", false, id: "check-all-items", style:"margin:0px;" %> <span>Select</span>
            </th>
            <th scope="col">Alias Agency Name</th>
          </tr>
        </thead>
        <tbody id="agency-item-rows">
          <%= render partial: 'shared/agency_item_rows', locals: { items: @aliases, table:'aliases' } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= javascript_include_tag 'agencies_manager' %>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        new AgenciesManager({
            tableSelector: ".agency-aliases-table",
            agencyId: <%= @agency.id %>,
            createUrl: "<%= agency_aliases_path %>",
            deleteUrl: "<%= agency_alias_path(@agency) %>"
        });
    });
</script>
