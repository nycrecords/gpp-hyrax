<% provide :page_header do %>
  <h1><span class="fa fa-tags" aria-hidden="true"></span> Manage Agency Aliases</h1>
<% end %>

<div class="panel panel-default">
  <div class="panel-body">
    <div class="table-responsive">
      <table class="table table-striped datatable agency-aliases-table">
        <thead>
          <tr>
            <th class="col-name">Agency Name</th>
            <th>Aliases</th>
            <th class="no-sort"></th>
          </tr>
        </thead>

        <tbody>
          <% @agencies.each do |agency| %>
            <tr>
              <td><%= agency.name %></td>
              <td>
                <% if agency.aliases.present? %>
                  <%= safe_join(agency.aliases.map(&:name), tag("br")) %>
                <% end %>
              </td>
              <td class="text-right">
                <%= link_to "Edit", edit_agency_alias_path(agency), class: "btn btn-sm btn-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
    $(function () {
        $('.agency-aliases-table').DataTable({
            destroy: true,
            columnDefs: [{ orderable: false, targets: 'no-sort' }]
        });
    });
</script>
